# which model classifies the emails: a preset name from pipeline/model_presets.py
#   gemma, gpt-oss-20b         local through Ollama, free and private, slow
#   gemini-flash-lite          Google cloud, free tier: about 500 requests a day
#   gemini-flash               Google cloud, free tier: about 20 requests a day
# a full LiteLLM model string also works, e.g. ollama_chat/gemma4:26b-a4b-it-qat
LLM_MODEL=gemma

# from https://aistudio.google.com, only needed for the gemini presets
# the free tier may use what you send to improve Google's products: check the terms
GEMINI_API_KEY=

# Ollama only
OLLAMA_API_BASE=http://localhost:11434
# context window in tokens: Ollama's default is too small for the longest emails and it truncates silently, so set it explicitly
OLLAMA_NUM_CTX=32768

# only used with a full model string; presets set their own
# none | low | medium | high (empty keeps the model's default (gemma4 thinks by default))
# LLM_REASONING_EFFORT=none
