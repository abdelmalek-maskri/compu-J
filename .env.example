# Copy this file to .env and fill in what you need

# ---- 1. Which model classifies the emails ----
# gemma               local (Ollama): free, private, slow
# gpt-oss-20b         local (Ollama): free, private, slow
# gemini-flash-lite   Google cloud: fast, free tier about 500 requests a day
# gemini-flash        Google cloud: stronger, free tier about 20 requests a day
LLM_MODEL=gemma

# ---- 2. API keys (leave empty if you do not use them) ----
# Gemini models: free key from https://aistudio.google.com
GEMINI_API_KEY=
# News ticker: free key from https://finnhub.io (without it, a public RSS feed is used)
FINNHUB_API_KEY=

# ---- 3. Local models only (Ollama) ----
OLLAMA_API_BASE=http://localhost:11434
# How much text the model reads at once. Ollama's default is too small for the longest emails.
OLLAMA_NUM_CTX=32768
