LLM_MODEL=ollama_chat/gemma4:26b-a4b-it-qat
OLLAMA_API_BASE=http://localhost:11434

# context window in tokens: Ollama's default is too small for the longest emails and it truncates silently, so set it explicitly
OLLAMA_NUM_CTX=32768

# none | low | medium | high (empty keeps the model's default (gemma4 thinks by default))
LLM_REASONING_EFFORT=none

# hosted alternative
# LLM_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=
